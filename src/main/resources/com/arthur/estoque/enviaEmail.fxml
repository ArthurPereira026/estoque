<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" style="-fx-border-radius: 20;" styleClass="fundo-login" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arthur.estoque.controller.SenhaController">
   <children>
      <Label styleClass="palavras" text="Recuperação de Senha" />
      <Label prefHeight="44.0" prefWidth="244.0" styleClass="palavras" text="Informe seu email para receber o codigo de verificação" wrapText="true">
         <VBox.margin>
            <Insets bottom="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="emailRecuperacao" promptText="email de recuperação" styleClass="campos-login">
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
      </TextField>
      <Label prefHeight="34.0" prefWidth="221.0" styleClass="palavras" text="Email não cadastrado! Tente Novamente!" wrapText="true">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
      <Button fx:id="btnEmailValido" mnemonicParsing="false" onAction="#aoEmailValido" prefHeight="25.0" prefWidth="100.0" styleClass="botao-login" text="Enviar">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
