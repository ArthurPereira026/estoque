<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" style="-fx-border-radius: 20;" styleClass="fundo-login" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arthur.estoque.controller.NovaSenhaController">
   <children>
      <Label styleClass="palavras" text="Recuperação de Senha" />
      <PasswordField fx:id="novaSenha" promptText="Nova Senha">
         <VBox.margin>
            <Insets bottom="20.0" left="50.0" right="50.0" top="20.0" />
         </VBox.margin>
      </PasswordField>
      <PasswordField fx:id="confirmaNovaSenha" layoutX="60.0" layoutY="119.0" onAction="#aoSenhaValida" promptText="Nova Senha">
         <VBox.margin>
            <Insets left="50.0" right="50.0" />
         </VBox.margin>
      </PasswordField>
      <Label fx:id="senhaIncorreta" alignment="CENTER" minWidth="350.0" prefHeight="34.0" prefWidth="177.0" styleClass="palavras" text="As senhas n se coencidem!" visible="false" wrapText="true">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
      <Button fx:id="btnSenhaValida" mnemonicParsing="false" onAction="#aoSenhaValida" prefHeight="25.0" prefWidth="100.0" styleClass="botao-login" text="Enviar">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
