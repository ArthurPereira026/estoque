<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="700.0" spacing="20.0" style="-fx-border-color: #A58162; -fx-border-width: 5;" styleClass="fundo-login" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arthur.estoque.controller.CadastroController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
   <HBox alignment="CENTER" prefHeight="71.0" prefWidth="670.0">
      <children>
         <FontIcon iconLiteral="mdi2a-account-multiple-plus" iconSize="50">
            <iconColor>
               <LinearGradient endX="0.8625592417061612" endY="0.7914691943127963" startX="0.933649289099526" startY="0.4691943127962086">
                  <stops>
                     <Stop>
                        <color>
                           <Color red="0.8980392217636108" green="0.6627451181411743" blue="0.32156863808631897" />
                        </color>
                     </Stop>
                     <Stop offset="1.0">
                        <color>
                           <Color red="0.03921568766236305" green="0.2666666805744171" blue="0.18039216101169586" />
                        </color>
                     </Stop>
                  </stops>
               </LinearGradient>
            </iconColor>
            <HBox.margin>
               <Insets right="20.0" />
            </HBox.margin>
         </FontIcon>
      
          <Label fx:id="textoNaTela" text="Sistema de Estoque - Cadastro de Usuário">
              <font>
                  <Font name="Gill Sans MT" size="24.0" />
              </font>
            <textFill>
               <LinearGradient endX="0.24644549763033174" endY="0.8767772511848341" startX="0.2796208530805687" startY="0.056872037914691975">
                  <stops>
                     <Stop>
                        <color>
                           <Color red="0.8980392217636108" green="0.6627451181411743" blue="0.32156863808631897" />
                        </color>
                     </Stop>
                     <Stop offset="1.0">
                        <color>
                           <Color red="0.03921568766236305" green="0.2666666805744171" blue="0.18039216101169586" />
                        </color>
                     </Stop>
                  </stops>
               </LinearGradient>
            </textFill>
         </Label>
      </children>
   </HBox>
   <VBox prefHeight="67.0" prefWidth="670.0">
      <children>
          <TextField fx:id="usuarioCadastrar" prefHeight="44.0" prefWidth="535.0" promptText="Informe seu usuário" styleClass="campos-login">
              <VBox.margin>
                  <Insets left="80.0" right="80.0" />
              </VBox.margin>
              <font>
                  <Font name="Gill Sans MT" size="16.0" />
              </font>
          </TextField>
         <Label fx:id="emailInvalido" onMouseClicked="#aoAcessarLogin" text="É necessario um email valido para continuar" textFill="#ffe100" visible="false">
            <font>
               <Font name="Gill Sans MT Italic" size="16.0" />
            </font>
            <VBox.margin>
               <Insets left="150.0" />
            </VBox.margin>
         </Label>
      </children>
      <VBox.margin>
         <Insets bottom="-20.0" />
      </VBox.margin>
   </VBox>
   <VBox prefHeight="68.0" prefWidth="670.0">
      <children>
         <PasswordField fx:id="confirmaSenha" prefHeight="44.0" prefWidth="535.0" promptText="Informe sua Senha" styleClass="campos-login">
            <VBox.margin>
               <Insets left="80.0" right="80.0" />
            </VBox.margin>
            <font>
               <Font name="Gill Sans MT" size="16.0" />
            </font>
         </PasswordField>
         <Label fx:id="senhaInvalida" onMouseClicked="#aoAcessarLogin" text="É necessario uma senha valida para continuar" textFill="#ffe100" visible="false">
            <font>
               <Font name="Gill Sans MT Italic" size="16.0" />
            </font>
            <VBox.margin>
               <Insets left="150.0" />
            </VBox.margin>
         </Label>
      </children>
      <VBox.margin>
         <Insets bottom="-20.0" />
      </VBox.margin>
   </VBox>
    <PasswordField fx:id="ConfirmaSenha" onAction="#aoConfirmarCadastro" prefHeight="44.0" prefWidth="460.0" promptText="Confirme sua senha" styleClass="campos-login">
        <VBox.margin>
            <Insets left="80.0" right="80.0" />
        </VBox.margin>
        <font>
            <Font name="Gill Sans MT" size="16.0" />
        </font>
    </PasswordField>
    <TextFlow fx:id="erroSenha" prefHeight="43.0" prefWidth="360.0" textAlignment="CENTER" translateY="-8.0" visible="false">
        <VBox.margin>
            <Insets left="50.0" right="50.0" />
        </VBox.margin>
        <children>
            <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="As senhas não se coincidem" textAlignment="CENTER">
                <font>
                    <Font name="Comic Sans MS Italic" size="14.0" />
                </font>
            </Text>
        </children>
    </TextFlow>
    <Button fx:id="btnCadastrar" cache="true" onAction="#aoConfirmarCadastro" prefHeight="44.0" prefWidth="349.0" text="Acessar" VBox.vgrow="ALWAYS">
        <font>
            <Font name="Gill Sans MT" size="21.0" />
        </font>
        <VBox.margin>
            <Insets top="-40.0" />
        </VBox.margin>
      <styleClass>
         <String fx:value="botao-login" />
         <String fx:value="botao" />
      </styleClass></Button>
    <Label fx:id="acessaLogin" onMouseClicked="#aoAcessarLogin" text="Possui uma conta?Acesse-a aqui!!" textFill="#bc9d82" underline="true">
        <font>
            <Font name="Gill Sans MT Italic" size="16.0" />
        </font>
        <VBox.margin>
            <Insets />
        </VBox.margin>
    </Label>
</VBox>
