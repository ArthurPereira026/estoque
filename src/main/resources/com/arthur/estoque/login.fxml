<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="700.0" spacing="20.0" style="-fx-border-color: #A58162; -fx-border-width: 5;" styleClass="fundo-login" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arthur.estoque.controller.LoginController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <FontIcon iconLiteral="mdi2a-account-credit-card-outline" iconSize="50">
      <fill>
         <LinearGradient endX="1.0" endY="1.0">
            <stops>
               <Stop>
                  <color>
                     <Color red="0.43921568989753723" green="0.0941176488995552" blue="0.5529412031173706" />
                  </color>
               </Stop>
               <Stop offset="1.0">
                  <color>
                     <Color red="0.43921568989753723" green="0.0941176488995552" blue="0.5529412031173706" />
                  </color>
               </Stop>
            </stops>
         </LinearGradient>
      </fill>
      <iconColor>
         <LinearGradient endX="1.0" endY="0.47867298578199047" startX="0.8151658767772512" startY="0.2559241706161137">
            <stops>
               <Stop>
                  <color>
                     <Color red="0.8980392217636108" green="0.6627451181411743" blue="0.32156863808631897" />
                  </color>
               </Stop>
               <Stop offset="1.0">
                  <color>
                     <Color red="0.03921568766236305" green="0.2666666805744171" blue="0.18039216101169586" />
                  </color>
               </Stop>
            </stops>
         </LinearGradient>
      </iconColor></FontIcon>

    <Label fx:id="textoNaTela" text="Sistema de Estoque">
        <font>
            <Font name="Gill Sans MT" size="24.0" />
        </font>
        <VBox.margin>
            <Insets bottom="20.0" />
        </VBox.margin>
      <textFill>
         <LinearGradient endX="0.8199052132701422" endY="0.8625592417061612" startX="0.8293838862559242" startY="0.37914691943127965">
            <stops>
               <Stop>
                  <color>
                     <Color red="0.8980392217636108" green="0.6627451181411743" blue="0.32156863808631897" />
                  </color>
               </Stop>
               <Stop offset="1.0">
                  <color>
                     <Color red="0.03921568766236305" green="0.2666666805744171" blue="0.18039216101169586" />
                  </color>
               </Stop>
            </stops>
         </LinearGradient>
      </textFill></Label>
    <TextField fx:id="usuario" prefHeight="44.0" prefWidth="535.0" promptText="Informe seu usuário" styleClass="campos-login">
        <VBox.margin>
            <Insets bottom="20.0" left="80.0" right="80.0" />
        </VBox.margin>
        <font>
            <Font name="Gill Sans MT" size="16.0" />
        </font>
    </TextField>
    <PasswordField fx:id="senha" onAction="#aoApertarBotao" prefHeight="44.0" prefWidth="460.0" promptText="Informe sua senha" styleClass="campos-login">
        <VBox.margin>
            <Insets bottom="-10.0" left="80.0" right="80.0" />
        </VBox.margin>
        <font>
            <Font name="Gill Sans MT" size="16.0" />
        </font>
    </PasswordField>
    <TextFlow fx:id="erroDados" prefHeight="43.0" prefWidth="360.0" textAlignment="CENTER" translateY="-8.0" visible="false">
        <VBox.margin>
            <Insets left="50.0" right="50.0" />
        </VBox.margin>
        <children>
            <Text fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text="Usuário ou senha Incorretos" textAlignment="CENTER">
                <font>
                    <Font name="Comic Sans MS Italic" size="14.0" />
                </font>
            </Text>
        </children>
    </TextFlow>
    <Button fx:id="btnAcessar" cache="true" onAction="#aoApertarBotao" prefHeight="44.0" prefWidth="349.0" text="Acessar" VBox.vgrow="ALWAYS">
        <font>
            <Font name="Gill Sans MT" size="21.0" />
        </font>
        <VBox.margin>
            <Insets top="-40.0" />
        </VBox.margin>
      <styleClass>
         <String fx:value="botao-login" />
         <String fx:value="botao" />
      </styleClass></Button>
    <Label fx:id="recuperaSenha" onMouseClicked="#aoEsquecerSenha" text="Esqueceu sua senha. Recupere aqui!" textFill="#bc9d82" underline="true">
        <font>
            <Font name="Gill Sans MT Italic" size="16.0" />
        </font>
        <VBox.margin>
            <Insets />
        </VBox.margin>
    </Label>
   <Label fx:id="novoCadastro" layoutX="251.0" layoutY="408.0" onMouseClicked="#aoCadastrar" text="N tem cadastro? Cadastre-se Aqui!!" textFill="#bc9d82" underline="true">
      <font>
         <Font name="Gill Sans MT Italic" size="16.0" />
      </font>
   </Label>
</VBox>
